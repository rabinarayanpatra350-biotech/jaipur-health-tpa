# Copy to .env. Nothing here is a real secret; production values live in the host's
# environment settings and are never committed.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/hospital
DATABASE_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://localhost:5173
REPORTING_DAYS=90

# console (dev) | record (tests) | smtp (production)
MAIL_TRANSPORT=console
MAIL_FROM=Jaipur Health TPA <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CLINIC_NOTIFICATION_EMAIL=opd@example.com

JOB_POLL_INTERVAL_MS=1000
JOB_VISIBILITY_TIMEOUT_MS=300000
UPLOAD_MAX_BYTES=5242880
LOG_LEVEL=debug
